APP_NAME="Vua Beach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOCAL_TUNNEL_HOST_SUFFIXES=.ngrok-free.dev,.ngrok-free.app
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Chỉ dùng một lần khi database chưa có quản trị viên; không commit giá trị thật.
ADMIN_INITIAL_PASSWORD=

# GHN (môi trường test) - điền sau khi tạo shop test tại https://5sao.ghn.dev/
GHN_ENABLED=true
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_WEBHOOK_SECRET=
WEBHOOK_MAX_PAYLOAD_BYTES=65536
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=300
GHN_VERIFY_SSL=true
GHN_DEFAULT_FEE=30000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Khi phát triển có thể dùng "log". Để gửi Gmail thật, đổi thành smtp và điền App Password.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Số bản sao lưu database gần nhất cần giữ.
DB_BACKUP_KEEP=14

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chỉ bật khi toàn bộ website đang phục vụ thử nghiệm; giao diện sẽ hiện cảnh báo Sandbox.
PAYMENT_SANDBOX_MODE=false

# MoMo Sandbox. Local có thể đặt RETURN_URL là http://localhost; IPN_URL luôn phải là HTTPS công khai.
MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=
MOMO_IPN_URL=

# VNPAY. Local có thể đặt RETURN_URL là http://localhost; IPN_URL luôn phải là HTTPS công khai.
VNPAY_ENABLED=false
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# Ít nhất một kênh nhận cảnh báo khi mail đã retry hết.
ALERT_WEBHOOK_URL=
# Bỏ trống để dùng MAIL_FROM_ADDRESS, hoặc đặt hộp thư vận hành riêng.
ALERT_MAIL_TO=
HEALTH_RUNTIME_HEARTBEAT_MAX_AGE_SECONDS=120
HEALTH_EXTERNAL_PROBE_CACHE_SECONDS=60
HEALTH_EXTERNAL_PROBE_CONNECT_TIMEOUT_SECONDS=3
HEALTH_EXTERNAL_PROBE_TIMEOUT_SECONDS=5

# Theo dõi exception/queue trên production. Tạo DSN tại Sentry rồi điền ở máy chủ.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_REQUEST_BODY_SIZE=never
SENTRY_TRACES_SAMPLE_RATE=0.1
