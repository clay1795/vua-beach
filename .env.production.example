APP_NAME="Vua Beach"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Chỉ liệt kê IP/CIDR reverse proxy thực tế; tuyệt đối không dùng * trên Internet.
TRUSTED_PROXIES=127.0.0.1,::1
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Vua Beach"
MAIL_TIMEOUT=10

FILESYSTEM_DISK=public

GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_WEBHOOK_SECRET=
WEBHOOK_MAX_PAYLOAD_BYTES=65536
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=300
GHN_VERIFY_SSL=true
GHN_DEFAULT_FEE=30000

# Chỉ bật tạm trước khi mở bán để cho phép cổng Sandbox và hiện cảnh báo toàn site.
# Bắt buộc trả về false trước khi nhận đơn/thanh toán thật.
PAYMENT_SANDBOX_MODE=false

MOMO_ENABLED=false
# Dùng URL production do MoMo cấp khi PAYMENT_SANDBOX_MODE=false.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=https://example.com/thanh-toan/momo/ket-qua
MOMO_IPN_URL=https://example.com/thanh-toan/momo/ipn

VNPAY_ENABLED=false
# Dùng URL production do VNPAY cấp khi PAYMENT_SANDBOX_MODE=false.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://example.com/thanh-toan/vnpay/ket-qua
VNPAY_IPN_URL=https://example.com/thanh-toan/vnpay/ipn

ALERT_WEBHOOK_URL=
HEALTH_RUNTIME_HEARTBEAT_MAX_AGE_SECONDS=120
HEALTH_EXTERNAL_PROBE_CACHE_SECONDS=60
HEALTH_EXTERNAL_PROBE_CONNECT_TIMEOUT_SECONDS=3
HEALTH_EXTERNAL_PROBE_TIMEOUT_SECONDS=5
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_REQUEST_BODY_SIZE=never
SENTRY_TRACES_SAMPLE_RATE=0.1

DB_BACKUP_KEEP=14
MYSQLDUMP_BINARY=mysqldump
