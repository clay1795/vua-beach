APP_NAME="Vua Beach Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vuabeach_staging
# Phải khớp chính xác database thực và chứa staging/stage/uat/preprod.
STAGING_DATABASE_GUARD=vuabeach_staging
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Chỉ liệt kê IP/CIDR reverse proxy thực tế; tuyệt đối không dùng * trên Internet.
TRUSTED_PROXIES=127.0.0.1,::1
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Vua Beach Staging"
MAIL_TIMEOUT=10

GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_WEBHOOK_SECRET=
WEBHOOK_MAX_PAYLOAD_BYTES=65536
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=300
GHN_VERIFY_SSL=true
GHN_DEFAULT_FEE=30000

PAYMENT_SANDBOX_MODE=true

MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=https://staging.example.com/thanh-toan/momo/ket-qua
MOMO_IPN_URL=https://staging.example.com/thanh-toan/momo/ipn

VNPAY_ENABLED=false
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://staging.example.com/thanh-toan/vnpay/ket-qua
VNPAY_IPN_URL=https://staging.example.com/thanh-toan/vnpay/ipn

ALERT_WEBHOOK_URL=
HEALTH_RUNTIME_HEARTBEAT_MAX_AGE_SECONDS=120
HEALTH_EXTERNAL_PROBE_CACHE_SECONDS=60
HEALTH_EXTERNAL_PROBE_CONNECT_TIMEOUT_SECONDS=3
HEALTH_EXTERNAL_PROBE_TIMEOUT_SECONDS=5
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_REQUEST_BODY_SIZE=never
SENTRY_TRACES_SAMPLE_RATE=0.2

DB_BACKUP_KEEP=14
MYSQLDUMP_BINARY=mysqldump
