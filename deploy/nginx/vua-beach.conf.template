# Replace vuabeach.vn, /var/www/vua-beach and the PHP-FPM socket before enabling.
# Install vua-beach-log-format.conf in /etc/nginx/conf.d/ first so callback
# signatures, reset tokens and webhook secrets never enter access logs.
# Test with: sudo nginx -t

server {
    listen 80;
    listen [::]:80;
    server_name vuabeach.vn www.vuabeach.vn;
    access_log /var/log/nginx/vua-beach.access.log vua_beach_no_query;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://vuabeach.vn$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name vuabeach.vn;
    access_log /var/log/nginx/vua-beach.access.log vua_beach_no_query;

    root /var/www/vua-beach/public;
    index index.php;
    charset utf-8;

    ssl_certificate /etc/letsencrypt/live/vuabeach.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vuabeach.vn/privkey.pem;

    client_max_body_size 16m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/xml
        image/svg+xml
        text/css
        text/plain
        text/xml;

    location /build/ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # Nginx does not inherit server-level add_header directives when a
        # location defines its own, so keep security headers on static assets.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }

    location ~* ^/(?:images|fonts)/.+\.(?:avif|gif|ico|jpe?g|png|svg|webp|woff2?)$ {
        try_files $uri =404;
        access_log off;
        expires 30d;
    }

    location /storage/ {
        try_files $uri =404;
        access_log off;
        expires 30d;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 120s;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\. {
        deny all;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.vuabeach.vn;
    access_log /var/log/nginx/vua-beach.access.log vua_beach_no_query;

    ssl_certificate /etc/letsencrypt/live/vuabeach.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vuabeach.vn/privkey.pem;

    return 301 https://vuabeach.vn$request_uri;
}
